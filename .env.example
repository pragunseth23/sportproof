# SportProof environment template.
# Copy to .env (gitignored) and fill in. Never commit .env or paste secrets into chat/logs.
# Full setup and funding instructions: docs/DEPLOYMENT.md

# --- Application ---
# Exact origin the web app is served from.
APP_BASE_URL=http://127.0.0.1:3000
# PostgreSQL connection string. Local workspace DB uses:
#   postgres://sportproof@127.0.0.1:54329/sportproof
DATABASE_URL=postgres://sportproof:sportproof@localhost:5432/sportproof
# "live" requires real model + chain config; missing pieces produce an explicit
# blocked state, never a scripted success.
DEMO_MODE=live

# --- Chain (Base Sepolia only) ---
# Must be 84532. Other networks are rejected in live mode.
CHAIN_ID=84532
# Provider-backed Base Sepolia HTTPS endpoint (e.g. Alchemy: create an app on
# Base Sepolia at https://dashboard.alchemy.com and copy the HTTPS URL).
RPC_URL=
# Filled from deployments/base-sepolia.json after `pnpm chain:deploy:testnet`.
MARKET_CONTRACT_ADDRESS=
MARKET_BYTECODE_HASH=
MARKET_DEPLOYMENT_BLOCK=
# Sealed L2 blocks required for funding and attestation. Keep >= 2.
CONFIRMATIONS=2

# --- Agents (live model calls) ---
# Key from https://platform.openai.com (Settings -> API keys). Needs credit balance.
OPENAI_API_KEY=
# A model your account can use with function tools, e.g. gpt-4o or gpt-4o-mini.
OPENAI_MODEL=
# Safety cap on model tool steps per mission run.
MAX_AGENT_STEPS=30

# --- Server-only secrets ---
# Two DIFFERENT random 32-byte hex values. Generate each with:
#   openssl rand -hex 32
REPORT_ENCRYPTION_KEY=
AGENT_KEY_ENCRYPTION_KEY=
# Reserved; sessions currently use random opaque tokens stored by SHA-256 hash.
SESSION_SECRET=
# Dedicated verifier TEST wallet key (created by scripts/prepare-testnet-roles.ts).
# Separate from deployer/buyer/seller. Fund with faucet test ETH only.
VERIFIER_PRIVATE_KEY=
# Fresh random seed for the hosted private demo data. Never commit or reuse the
# public seed:local fixtures here.
PRIVATE_DEMO_SEED=
# Per-transaction gas spend ceiling in wei.
MAX_GAS_PER_TX_WEI=100000000000000

# --- Optional ---
# Etherscan/BaseScan API key for contract source verification (free at
# https://etherscan.io/myapikey).
ETHERSCAN_API_KEY=
# Isolated database for `pnpm test` PostgreSQL suites; tests skip if unset.
TEST_DATABASE_URL=
# Password for the PostgreSQL service in compose.yaml.
POSTGRES_PASSWORD=
# Cap on missions created per day (uses code default if unset).
#MAX_DAILY_MISSIONS=
# Paths to Foundry binaries if not on PATH (local contract tests/deploys).
#FORGE_BIN=
#ANVIL_BIN=

# DEPLOYER_PRIVATE_KEY and VERIFIER_ADDRESS are operator-only and belong in
# .local/operator.env (written by scripts/prepare-testnet-roles.ts), never here.

# When true, buyer missions always require the visitor's own OpenAI key; the
# platform OPENAI_API_KEY then powers only seller/organizer agents.
FORCE_BYOK=

# Anthropic platform key for seller/organizer agents (takes precedence over the
# OpenAI pair below when both are set). Model defaults to claude-opus-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Required only when ANTHROPIC_API_KEY is an org-level key (not workspace-scoped).
ANTHROPIC_WORKSPACE_ID=
